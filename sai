#!/usr/bin/env bash
# Server AI Assistant launcher
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "${ROOT}/.venv/bin/python" ]]; then
  exec "${ROOT}/.venv/bin/python" "${ROOT}/sai.py" "$@"
fi
if command -v python3 >/dev/null 2>&1; then
  exec python3 "${ROOT}/sai.py" "$@"
fi
echo "python3 not found" >&2
exit 127
